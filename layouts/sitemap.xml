{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- $asOf := "" -}}
  {{- with hugo.Data.cv }}{{ with .freshness }}{{ $asOf = .asOf | default "" }}{{ end }}{{ end }}
  {{- range where .Pages "Params.noindex" "!=" true }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ with $asOf }}
    <lastmod>{{ (time.AsTime .).Format "2006-01-02" }}</lastmod>{{ end }}
  </url>
  {{- end }}
</urlset>
